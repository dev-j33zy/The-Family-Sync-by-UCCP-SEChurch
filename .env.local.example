# =============================================
# THE FAMILY SYNC — Environment Variables
# Copy this file to .env.local and fill in values
# =============================================

# The app stores data in three separate MongoDB Atlas clusters:
#
#   1) admin   -> users + sessions                 (MONGODB_URI)
#   2) members -> groups, members, relationships,
#                 text blasts                        (MONGODB_URI_MEMBERS)
#   3) images  -> profile photo bytes              (MONGODB_URI_IMAGES)
#
# Atlas:  Dashboard → Database → Connect → Drivers → copy the SRV string.
#         Add your current IP under Network Access, and include a database name
#         (e.g. db-admin-user / db-members / db-images) before the query string.
#
# Passwords with special characters must be percent-encoded (@ -> %40,
# $ -> %24, : -> %3A, / -> %2F, ? -> %3F, # -> %23).

MONGODB_URI=mongodb+srv://USER:PASSWORD@admin-cluster.example.mongodb.net/db-admin-user?retryWrites=true&w=majority
MONGODB_URI_MEMBERS=mongodb+srv://USER:PASSWORD@members-cluster.example.mongodb.net/db-members?retryWrites=true&w=majority
MONGODB_URI_IMAGES=mongodb+srv://USER:PASSWORD@images-cluster.example.mongodb.net/db-images?retryWrites=true&w=majority

# App URL (used for links in invites and password-reset emails).
# Required in production; local dev falls back to the request host.
# NEXT_PUBLIC_APP_URL=https://your-domain.example

# =============================================
# GOOGLE API (email + Sheets export)
#
# Sends admin invitations, password-reset links and account-change
# notifications, and creates the exported Google Sheets. Free with a Google
# Workspace mailbox.
#
# Setup:
#   1. console.cloud.google.com → new project → enable Gmail API,
#      Google Sheets API and Google Drive API
#   2. OAuth consent screen → User type: Internal → publish
#   3. Credentials → OAuth client ID → Desktop app
#   4. Put the client id/secret below, then run:
#        npm run google-auth
#      and paste the refresh token it prints.
# =============================================

# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=

# The From address. Must be the authorized mailbox itself or an alias verified
# under Gmail → Settings → Accounts → "Send mail as".
# EMAIL_FROM="The Family Sync <no-reply@your-domain.example>"

# Secret key that protects the public widget endpoints (used by the desktop widget)
WIDGET_API_KEY=generate-a-long-random-string

# SMS provider. 'log' records sends in the server console; replace when a provider is configured.
SMS_PROVIDER=log

# Only needed when SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# Dialing code assumed for member phone numbers. Public so the compose screen
# can normalise numbers in the browser.
# NEXT_PUBLIC_SMS_DEFAULT_COUNTRY_CODE=63
