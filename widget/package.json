{
  "name": "family-sync-widget",
  "version": "1.4.2",
  "description": "Desktop widget showing upcoming birthdays and anniversaries from The Family Sync",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "generate-icons": "node scripts/generate-icons.js",
    "build": "npm run build:portable",
    "build:portable": "npm run generate-icons && electron-builder --win portable",
    "build:setup": "npm run generate-icons && electron-builder --win nsis",
    "build:all": "npm run generate-icons && electron-builder --win portable nsis"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "sharp": "^0.35.2"
  },
  "build": {
    "appId": "com.uccp.family-sync-widget",
    "productName": "Family Sync Widget",
    "icon": "assets/icon-256.png",
    "files": [
      "**/*",
      "!**/.env",
      "!dist/**",
      "!scripts/**"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "assets/icon-256.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Family Sync Widget Setup ${version}.exe"
    },
    "portable": {
      "artifactName": "Family Sync Widget ${version}.exe"
    }
  }
}
